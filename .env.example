# FjordLens needs no API keys, accounts or secrets. Every setting below is optional.
# Wall-clock budget for the whole batch, in seconds (the run always finishes and writes every envelope).
SIGNALPOST_TIME_BUDGET_SECONDS=2600
# Total HTTP attempts for the batch (default: 30 x companies, minimum 2000).
SIGNALPOST_MAX_REQUESTS=
# HTTP attempts per company (default 40).
FJORDLENS_PER_COMPANY=40
